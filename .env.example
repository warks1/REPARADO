VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Mantener false en REPARADO Test. Solo muestra el registro público si se
# habilita explícitamente, y NO reemplaza la restricción en Supabase Auth.
VITE_REPARADO_ALLOW_PUBLIC_REGISTRATION=false

# Notificaciones push nativas. Mantener false hasta tener google-services.json
# (Android), capacidad Push Notifications (iOS) y un servicio de envío auditado.
VITE_REPARADO_PUSH_ENABLED=false
